# Copy this file to .env and fill in real values.

# --- Study area (Mohali + adjoining Chandigarh sectors) ---
CENTRE_LAT=30.71
CENTRE_LON=76.75
RADIUS_KM=8.0

# Emergency coverage threshold in minutes (used by the CLI pipeline; the UI
# default mirrors this value).
DEFAULT_THRESHOLD_MIN=15

# Path to a WorldPop GeoTIFF, or leave empty to use the synthetic fallback.
POP_RASTER=

# --- Google Gen AI ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash